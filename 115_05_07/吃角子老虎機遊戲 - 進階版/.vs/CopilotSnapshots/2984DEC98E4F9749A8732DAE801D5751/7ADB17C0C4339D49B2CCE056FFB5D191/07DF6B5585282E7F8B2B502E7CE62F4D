        private void button1_Click(object sender, EventArgs e)
        {
            // 旋轉按鈕（執行遊戲流程）
            int bet = GetSelectedBet();
            if (bet <= 0) return;

            if (balance < bet)
            {
                MessageBox.Show("餘額不足，無法下注", "錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                UpdateRotateButtonState();
                return;
            }

            // 從 balance 扣除下注金額
            balance -= bet;

            // 以亂數決定三個轉輪索引 (0..9)
            n1 = rand.Next(0, 10);
            n2 = rand.Next(0, 10);
            n3 = rand.Next(0, 10);
            // 動畫前準備
            lastBet = bet;
            spinTick = 0;
            pb1Stopped = pb2Stopped = pb3Stopped = false;

            // 初始化或開始計時器
            if (spinTimer == null)
            {
                spinTimer = new Timer();
                spinTimer.Interval = 80; // 80ms
                spinTimer.Tick += SpinTimer_Tick;
            }

            // 啟動動畫
            spinTimer.Start();

            // 更新介面（按鈕會依動畫狀態停用）
            UpdateUi();
        }

        private void button2_Click(object sender, EventArgs e)
        {
            // 計算結算資料
            int netGain = balance - totalDeposited;

            string msg = string.Format("累計存入：{0}\r\n目前餘額：{1}\r\n{2}：{3}\r\n\r\n旋轉次數：{4} 次　中獎次數：{5} 次",
                totalDeposited.ToString("C"),
                balance.ToString("C"),
                netGain >= 0 ? "獲利" : "虧損",
                Math.Abs(netGain).ToString("C"),
                totalSpins,
                winCount);

            MessageBox.Show(msg, "結算資訊", MessageBoxButtons.OK, MessageBoxIcon.Information);
            this.Close();
        }

        // 輔助方法
        private int GetSelectedBet()
        {
            if (comboBox1.SelectedItem == null) return 0;
            var s = comboBox1.SelectedItem.ToString();
            if (s.StartsWith("$")) s = s.Substring(1);
            int v;
            if (int.TryParse(s, out v)) return v;
            return 0;
        }

        private int CalculatePrize(int bet, int a, int b, int c)
        {
            if (a == b && b == c) return bet * 10; // 頭獎
            if (a == b || a == c || b == c) return bet * 2; // 普獎
            return 0; // 未中獎
        }

        private void UpdateUi()
        {
            // 每次餘額或獎金改變後呼叫，更新餘額與本次獲得，及旋轉按鈕狀態
            label_balance.Text = "餘額：" + balance.ToString("C");
            label1.Text = "本次獲得：" + prize.ToString("C");

            // 判斷旋轉按鈕狀態
            UpdateRotateButtonState();
        }

        private void UpdateStats()
        {
            // 每次旋轉結束後呼叫，更新統計顯示
            if (this.label_totalSpins != null)
            {
                label_totalSpins.Text = string.Format("旋轉：{0} 次", totalSpins);
            }
            if (this.label_winCount != null)
            {
                label_winCount.Text = string.Format("中獎：{0} 次", winCount);
            }
            if (this.label_winRate != null)
            {
                string rate = "0.0%";
                if (totalSpins > 0)
                {
                    double r = (double)winCount * 100.0 / (double)totalSpins;
                    rate = string.Format("{0:0.0}%", r);
                }
                label_winRate.Text = string.Format("勝率：{0}", rate);
            }
        }

        private void UpdateRotateButtonState()
        {
            int bet = GetSelectedBet();
            // 在動畫進行中時，旋轉按鈕必須停用
            if (spinTimer != null && spinTimer.Enabled)
            {
                button1.Enabled = false;
                return;
            }

            if (balance == 0 || balance < bet)
            {
                button1.Enabled = false;
            }
            else
            {
                button1.Enabled = true;
            }
        }

        private Bitmap CreateNumberBitmap(int number, int width, int height)
        {
            if (width <= 0) width = 100;
            if (height <= 0) height = 100;
            Bitmap bmp = new Bitmap(width, height);
            using (Graphics g = Graphics.FromImage(bmp))
            {
                g.Clear(Color.White);
                string s = number.ToString();
                using (Font f = new Font("微軟正黑體", Math.Max(12, Math.Min(width, height) / 2), FontStyle.Bold, GraphicsUnit.Pixel))
                using (Brush br = new SolidBrush(Color.Black))
                {
                    SizeF sz = g.MeasureString(s, f);
                    float x = (width - sz.Width) / 2f;
                    float y = (height - sz.Height) / 2f;
                    g.DrawString(s, f, br, x, y);
                }
            }
            return bmp;
        }

