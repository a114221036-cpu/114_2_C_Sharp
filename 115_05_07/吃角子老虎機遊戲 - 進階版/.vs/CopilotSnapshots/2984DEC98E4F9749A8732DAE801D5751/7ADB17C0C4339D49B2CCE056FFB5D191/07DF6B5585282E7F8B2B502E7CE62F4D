        // 如果有 ImageList 並且包含編號對應的圖，回傳該圖；否則回傳以數字繪製的 Bitmap
        private Image GetImageForNumber(int number, int width, int height)
        {
            try
            {
                if (this.imageList1 != null && this.imageList1.Images.Count > number)
                {
                    // ImageList 存放的是 Image，直接使用（不需 Dispose）
                    return this.imageList1.Images[number];
                }
            }
            catch
            {
                // 忽略任何取圖錯誤，改用繪製
            }

            return CreateNumberBitmap(number, width, height);
        }

        private void DisposeIfNotFromImageList(PictureBox pb)
        {
            if (pb == null) return;
            if (pb.Image == null) return;
            // 如果 imageList1 包含此 Image 的參考，則不要 Dispose
            if (this.imageList1 != null)
            {
                foreach (Image img in this.imageList1.Images)
                {
                    if (object.ReferenceEquals(img, pb.Image))
                    {
                        pb.Image = null; // 不 Dispose
                        return;
                    }
                }
            }

            // 否則釋放
            var old = pb.Image;
            pb.Image = null;
            old.Dispose();
        }
