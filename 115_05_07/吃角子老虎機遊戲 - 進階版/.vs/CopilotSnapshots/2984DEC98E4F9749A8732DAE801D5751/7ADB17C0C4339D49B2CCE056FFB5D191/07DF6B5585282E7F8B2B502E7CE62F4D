            comboBox1.SelectedIndexChanged += ComboBox1_SelectedIndexChanged;

            // 初始化 pictureBox 顯示（若有 ImageList 就使用裡面的圖）
            pictureBox1.Image = GetImageForNumber(0, pictureBox1.Width, pictureBox1.Height);
            pictureBox2.Image = GetImageForNumber(0, pictureBox2.Width, pictureBox2.Height);
            pictureBox3.Image = GetImageForNumber(0, pictureBox3.Width, pictureBox3.Height);

            // 初始化 UI 文字
            UpdateUi();
        }

        private void SpinTimer_Tick(object sender, EventArgs e)
        {
            spinTick++;

            // 尚未停止的轉輪顯示隨機圖片
            if (!pb1Stopped)
            {
                int r = rand.Next(0, 10);
                pictureBox1.Image = GetImageForNumber(r, pictureBox1.Width, pictureBox1.Height);
            }
            if (!pb2Stopped)
            {
                int r = rand.Next(0, 10);
                pictureBox2.Image = GetImageForNumber(r, pictureBox2.Width, pictureBox2.Height);
            }
            if (!pb3Stopped)
            {
                int r = rand.Next(0, 10);
                pictureBox3.Image = GetImageForNumber(r, pictureBox3.Width, pictureBox3.Height);
            }

            // Tick 第 10 次停止第一個
            if (!pb1Stopped && spinTick >= TICKS_STOP_PB1)
            {
                pb1Stopped = true;
                pictureBox1.Image = GetImageForNumber(n1, pictureBox1.Width, pictureBox1.Height);
            }

            // Tick 第 17 次停止第二個
            if (!pb2Stopped && spinTick >= TICKS_STOP_PB2)
            {
                pb2Stopped = true;
                pictureBox2.Image = GetImageForNumber(n2, pictureBox2.Width, pictureBox2.Height);
            }

            // Tick 第 24 次停止第三個
            if (!pb3Stopped && spinTick >= TICKS_STOP_PB3)
            {
                pb3Stopped = true;
                pictureBox3.Image = GetImageForNumber(n3, pictureBox3.Width, pictureBox3.Height);

                // 動畫完成，停止計時器並執行勝負判斷與統計更新
                if (spinTimer != null)
                {
                    spinTimer.Stop();
                }

                // 計算獎金（使用預先儲存的 lastBet 與 n1,n2,n3）
                prize = CalculatePrize(lastBet, n1, n2, n3);
                if (prize > 0)
                {
                    balance += prize;
                    winCount += 1;
                }

                totalSpins += 1;

                // 更新介面與統計
                UpdateUi();
                UpdateStats();
            }
        }

